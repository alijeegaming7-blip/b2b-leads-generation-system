# =============================================================================
# Prospex AI Sales Intelligence - Environment Configuration
# =============================================================================

# Environment (development, staging, production)
ENV=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./prospex.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/prospex

# Redis Cache (optional - for production)
# REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenAI / LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: for OpenAI-compatible APIs

# Email Configuration (Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Optional: External Services
# PERPLEXITY_API_KEY=your_perplexity_key
# CLEARBIT_API_KEY=your_clearbit_key
# HUNTER_API_KEY=your_hunter_io_key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Security
# SECRET_KEY=your_application_secret_key

# Agent Configuration
AGENT_MAX_CONCURRENT=5
AGENT_CYCLE_DELAY_SECONDS=8

# =============================================================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual configuration
# 3. Never commit .env to version control
# 4. Use strong, unique secrets for production
# =============================================================================
